   "source": [
    "s_4 = input()\n",
    "\n",
    "cleaned = \"\"\n",
    "for char in s_4:\n",
    "    if char.isalnum():\n",
    "        cleaned += char.lower()\n",
    "\n",
    "if cleaned[::-1] == cleaned:\n",
    "    print(\"Palindrome\")\n",
    "else:\n",
    "    print(\"Not palindrome\")"
   ]
  }
