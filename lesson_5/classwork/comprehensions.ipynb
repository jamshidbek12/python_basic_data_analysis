   "source": [
    "def check_prime_num(num):\n",
    "    if num <= 2:\n",
    "        return False\n",
    "    if num%2 == 0:\n",
    "        return False\n",
    "    i = 3\n",
    "    while i*i<=num:\n",
    "        if num%i == 0:\n",
    "            return False\n",
    "        i+=2\n",
    "    return True\n",
    "\n",
    "number = int(input())\n",
    "check_prime_num(number)"
   ]
